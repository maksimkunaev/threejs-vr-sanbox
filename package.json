{
  "name": "threejs-vr-sandbox",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "dat.gui": "^0.7.7",
    "three": "^0.133.1"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^22.0.2",
    "@rollup/plugin-node-resolve": "^13.3.0",
    "rollup": "^2.78.0",
    "rollup-plugin-livereload": "^2.0.5",
    "rollup-plugin-typescript2": "^0.32.1",
    "serve": "^14.0.1",
    "typescript": "^4.7.4"
  },
  "scripts": {
    "build": "rollup -c --environment PORT=4444 --environment INCLUDE_DEPS,BUILD:production",
    "dev": "rollup -c --environment PORT=4444 --environment INCLUDE_DEPS,BUILD:production --watch",
    "demo": "serve src/demo/ -p 5000"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
